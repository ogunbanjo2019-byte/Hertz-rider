NODE_ENV=development
PORT=4000
DATABASE_PROVIDER=memory
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
DAILY_DRIVER_SUBSCRIPTION_FEE=1500
DEFAULT_CNG_UNIT=kg
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SENSITIVE_STORAGE_BUCKET=sensitive-documents
SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=5242880
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,application/pdf
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:4000/admin
MINIMUM_SUPPORTED_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
APP_STORE_LINK=
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@switchride.local
APP_PUBLIC_URL=http://localhost:4000
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
OTP_RATE_LIMIT=5
RESET_RATE_LIMIT=5
IDENTITY_PROVIDER=
IDENTITY_PROVIDER_API_KEY=
PAYOUT_PROVIDER=paystack
LOG_LEVEL=info
